{
  "init_from": "checkpoints/colab/sft.pt",
  "out_path": "checkpoints/colab/grpo.pt",
  "corpus_path": "data/input.txt",
  "tasks": ["word"],
  "phrasings": [2],
  "batch_size": 32,
  "group_size": 16,
  "temperature": 1.0,
  "max_new_tokens": 128,
  "micro_batch": 128,
  "kl_coef": 0.04,
  "max_iters": 150,
  "eval_interval": 25,
  "learning_rate": 3e-5,
  "min_lr": 3e-6,
  "warmup_iters": 10,
  "eval_per_task": 100,
  "precision": "auto",
  "resume": true,
  "state_every": 2
}
