{
  "init_from": "checkpoints/colab/sft.pt",
  "out_path": "checkpoints/colab/dpo.pt",
  "corpus_path": "data/input.txt",
  "tasks": ["add", "sub", "mul", "div", "word"],
  "n_pairs": 8000,
  "samples_per_prompt": 4,
  "max_new_tokens": 128,
  "beta": 0.1,
  "nll_coef": 1.0,
  "batch_size": 32,
  "max_iters": 1000,
  "eval_interval": 100,
  "learning_rate": 1e-5,
  "min_lr": 1e-6,
  "warmup_iters": 20,
  "eval_per_task": 100,
  "precision": "auto",
  "resume": true,
  "state_every": 2
}
