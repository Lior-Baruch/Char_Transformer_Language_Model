{
  "init_from": "checkpoints/example/sft_reasoning.pt",
  "out_path": "checkpoints/example/grpo_reasoning.pt",
  "corpus_path": "data/input.txt",
  "tasks": ["add", "sub", "mul", "div", "word"],
  "batch_size": 16,
  "group_size": 8,
  "temperature": 1.0,
  "max_new_tokens": 100,
  "kl_coef": 0.04,
  "max_iters": 300,
  "eval_interval": 25,
  "learning_rate": 1e-4,
  "min_lr": 1e-5,
  "warmup_iters": 10,
  "eval_per_task": 50
}
