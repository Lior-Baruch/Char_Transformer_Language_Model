# model checkpoints saved during training
*.pt
# except the example models
!checkpoints/example/*.pt
# training state for resuming (large, deleted when a run finishes)
*.state.pt
__pycache__/
*.egg-info/
# training logs of the demo runs
logs/
*.tmp
# corpora downloaded by `python -m charlm prepare-data` (data/input.txt is part of the repository)
data/*
!data/input.txt
